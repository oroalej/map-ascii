# dependencies
node_modules/
.pnpm-store/

# Next.js
.next/
out/
next-env.d.ts
.vercel/

# TypeScript
*.tsbuildinfo

# tests
coverage/
playwright-report/
test-results/
blob-report/
playwright/.cache/

# env (the site is fully static; keep any local secrets out of git)
.env
.env*.local

# logs
*.log
npm-debug.log*
pnpm-debug.log*

# temporary local probes
*.tmp.*

# OS / editors
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# data pipeline (raw downloads and intermediates; regenerate with `pnpm data:build`)
packages/data/raw/
packages/data/build/

# generated per-city tiles, meta, detail fingerprints, search index, subdivisions, and art (see docs/DATA.md)
apps/web/public/tiles/*.pmtiles
apps/web/public/tiles/*.meta.json
apps/web/public/tiles/*.detail-layouts.json
apps/web/public/tiles/*.search-index.json
apps/web/public/tiles/*.subdivisions.json
apps/web/public/tiles/*.art.json
apps/web/public/tiles/imagery/

# agent handoff plans (Claude writes them, Codex implements them; see AGENTS.md)
.plans/

# nested agent worktrees (see AGENTS.md "Git")
/worktrees/

# local Claude settings (generated instruction exclusions and personal configuration)
/.claude/settings.local.json
