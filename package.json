{
  "name": "ascii-atlas",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.1",
  "engines": {
    "node": ">=22.13 <23"
  },
  "scripts": {
    "diag:life": "tsx scripts/heavy.ts --exclusive packages/renderer/scripts/diag-life.ts",
    "perf:life": "tsx scripts/heavy.ts --exclusive packages/renderer/scripts/perf-life.ts",
    "perf:world": "tsx scripts/heavy.ts --exclusive packages/renderer/scripts/perf-world.ts",
    "perf:tiles": "tsx scripts/heavy.ts --exclusive packages/renderer/scripts/perf-tiles.ts",
    "perf:browser": "pnpm --filter @atlas/web perf:browser",
    "demo:video": "pnpm --filter @atlas/web demo:video",
    "perf:inspection": "tsx packages/renderer/scripts/perf-inspection.ts",
    "dev": "pnpm --filter @atlas/web dev",
    "build": "pnpm --filter @atlas/web build",
    "build:force": "pnpm --filter @atlas/web build:force",
    "check:budgets": "pnpm --filter @atlas/web check:budgets",
    "check:e2e-budget": "tsx apps/web/scripts/check-e2e-budget.ts",
    "data:build": "pnpm --filter @atlas/data build",
    "data:fetch": "pnpm --filter @atlas/data fetch-tiles",
    "data:publish": "pnpm --filter @atlas/data publish-tiles",
    "test": "vitest run",
    "test:related": "vitest related --run",
    "test:e2e": "pnpm --filter @atlas/web test:e2e",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck && tsc -p scripts --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify:life": "tsx scripts/heavy.ts packages/renderer/scripts/verify-life.ts",
    "prepare": "git config core.hooksPath .githooks || true",
    "worktree:new": "tsx scripts/worktree-new.ts",
    "plans:clean": "tsx scripts/plans-clean.ts",
    "worktree:remove": "tsx scripts/worktree-remove.ts",
    "worktree:stop": "tsx scripts/worktree-stop.ts",
    "cli:latest": "tsx scripts/latest-cli.ts",
    "review:state": "tsx scripts/pr-review-state.ts",
    "handoff:apply": "tsx scripts/handoff-apply.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@types/node": "^22.20.4",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "globals": "^17.12.0",
    "jsdom": "^29.1.1",
    "prettier": "^3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71",
    "vitest": "^5"
  }
}
