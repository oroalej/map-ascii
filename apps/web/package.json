{
  "name": "@atlas/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13 <23"
  },
  "scripts": {
    "dev": "next dev",
    "build": "tsx scripts/build.ts",
    "build:force": "tsx scripts/build.ts --force",
    "check:budgets": "tsx scripts/check-budgets.ts",
    "serve": "tsx scripts/serve.ts",
    "perf:browser": "pnpm build && tsx ../../scripts/heavy.ts --exclusive scripts/perf-browser.ts",
    "test:e2e": "tsx scripts/test-e2e.ts",
    "typecheck": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@atlas/content": "workspace:^",
    "@atlas/renderer": "workspace:^",
    "@atlas/shared": "workspace:^",
    "fflate": "0.8.3",
    "minisearch": "^7.2.0",
    "next": "16.3.6",
    "react": "^19.3",
    "react-dom": "^19.3",
    "zod": "^4.6",
    "zustand": "^5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "serve": "^14.2.6"
  }
}
